# ==============================================================================
# CodeBridge Backend — Root Environment Configuration Example
# ==============================================================================
# Copy to .env for Docker Compose or local orchestration. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Configuration:
# For Neon Cloud PostgreSQL:
# POSTGRES_USER=neondb_owner
# POSTGRES_PASSWORD=your_neon_password
# POSTGRES_HOST=ep-xxxx-xxxx.c-4.ap-southeast-1.aws.neon.tech
# POSTGRES_PORT=5432
# POSTGRES_SSL_PARAM=?ssl=require
#
# For Local Docker PostgreSQL:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_PARAM=

# Redis Configuration (Upstash Cloud or local Docker):
# REDIS_URL=rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Razorpay & Sovereign PayRail Integration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
RAZORPAYX_ACCOUNT_NUMBER=2323230041626905

# GenAI & Observability Stack (Gemini + LangSmith + LangGraph)
GEMINI_API_KEY=your-gemini-api-key-here
LANGSMITH_API_KEY=lsv2_pt_placeholder
LANGSMITH_PROJECT=codebridge-ai
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Prometheus & Grafana Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ENABLED=true

# Frontend CORS (comma-separated origins or * for open dev)
CORS_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# Shared Dev Security Secrets (MUST replace with random >=32-char secrets in production)
JWT_SECRET_KEY=dev-only-insecure-secret-key-change-before-production-32bytes
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
VERIFICATION_SIGNING_SECRET=dev-verification-hmac-secret-change-me-32chars
GITHUB_TOKEN_ENCRYPTION_KEY=REVWX09OTFlfSU5TRUNVUkVfS0VZX0RPX05PVF9VU0U=

# GitHub OAuth App Placeholders
GITHUB_CLIENT_ID=dev-github-client-id-placeholder
GITHUB_CLIENT_SECRET=dev-github-client-secret-placeholder
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/github/oauth/callback

# Google OAuth Credentials (Google Identity Services)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-placeholder

# Code Context Providers (mock/none safe defaults)
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=none

# Load Balancer & Edge Proxy Ports
LOAD_BALANCER_HTTP_PORT=80
LOAD_BALANCER_HTTPS_PORT=443

# High Concurrency HTTP Limits
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_KEEPALIVE_CONNECTIONS=100

# Service Ports & Base URLs (local host defaults)
API_GATEWAY_PORT=8000
IDENTITY_SERVICE_PORT=8001
PROJECT_SERVICE_PORT=8002
GITHUB_SERVICE_PORT=8003
CODE_CONTEXT_SERVICE_PORT=8004
WORKSPACE_SERVICE_PORT=8005
REVIEW_SERVICE_PORT=8006
VERIFICATION_SERVICE_PORT=8007
PAYMENT_SERVICE_PORT=8008
NOTIFICATION_SERVICE_PORT=8009
ADMIN_SERVICE_PORT=8010
AUDIT_SERVICE_PORT=8011
OBSERVABILITY_SERVICE_PORT=8012
HTTP_CLIENT_TIMEOUT_SECONDS=10.0
