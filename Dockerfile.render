# Render service #1: public API gateway + identity, project, workspace,
# payment and notification services in one container (fits the 512 MB tier).
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=10000 \
    MALLOC_ARENA_MAX=2 \
    KAFKA_ENABLED=false \
    WORKSPACE_ALLOW_MOCK_IN_PRODUCTION=true \
    IDENTITY_SERVICE_URL=http://127.0.0.1:8001 \
    PROJECT_SERVICE_URL=http://127.0.0.1:8002 \
    WORKSPACE_SERVICE_URL=http://127.0.0.1:8005 \
    PAYMENT_SERVICE_URL=http://127.0.0.1:8008 \
    NOTIFICATION_SERVICE_URL=http://127.0.0.1:8009

# GITHUB/REVIEW/VERIFICATION/ADMIN/AUDIT/CODE_CONTEXT/OBSERVABILITY_SERVICE_URL
# must point at Render service #2 (set them in the Render dashboard).

WORKDIR /app

COPY api-gateway/requirements.txt /tmp/req_gateway.txt
COPY services/identity-service/requirements.txt /tmp/req_identity.txt
COPY services/project-service/requirements.txt /tmp/req_project.txt
COPY services/workspace-service/requirements.txt /tmp/req_workspace.txt
COPY services/payment-service/requirements.txt /tmp/req_payment.txt
COPY services/notification-service/requirements.txt /tmp/req_notification.txt

RUN cat /tmp/req_*.txt | grep -viE '^(pytest|pytest-asyncio)([<>=~ ]|$)' | sort -u > /tmp/all_requirements.txt && \
    pip install --no-cache-dir -r /tmp/all_requirements.txt && \
    rm -f /tmp/req_*.txt /tmp/all_requirements.txt

COPY shared /app/shared
COPY api-gateway /app/api-gateway
COPY services/identity-service /app/services/identity-service
COPY services/project-service /app/services/project-service
COPY services/workspace-service /app/services/workspace-service
COPY services/payment-service /app/services/payment-service
COPY services/notification-service /app/services/notification-service
COPY render_launcher.py /app/render_launcher.py
COPY entrypoint.sh /app/entrypoint.sh

RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 10000

CMD ["/bin/bash", "/app/entrypoint.sh"]
