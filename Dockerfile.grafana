# Render service #3 (optional): Grafana for the embedded Analytics panels.
# Required Render env vars: POSTGRES_HOST, GRAFANA_DB_USER, GRAFANA_DB_PASSWORD,
# GF_SECURITY_ADMIN_PASSWORD. See docs/grafana-setup.md.
FROM grafana/grafana-oss:11.3.0

ENV GF_PATHS_CONFIG=/etc/grafana/grafana.ini \
    GF_INSTALL_PLUGINS=""

COPY infrastructure/monitoring/grafana/grafana.render.ini /etc/grafana/grafana.ini
COPY infrastructure/monitoring/grafana/provisioning/datasources /etc/grafana/provisioning/datasources
COPY infrastructure/monitoring/grafana/provisioning/dashboards /etc/grafana/provisioning/dashboards
COPY infrastructure/monitoring/grafana/dashboards/codebridge-platform-analytics.json /var/lib/grafana/dashboards/codebridge-platform-analytics.json

# Render injects $PORT; Grafana reads GF_SERVER_HTTP_PORT.
ENTRYPOINT ["/bin/sh", "-c", "export GF_SERVER_HTTP_PORT=${PORT:-3000}; exec /run.sh"]
